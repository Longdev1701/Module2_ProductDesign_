# ─── Supabase Database ─────────────────────────────────
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-sb-publishable-key"
SUPABASE_SECRET_KEY="your-sb-secret-key"
SUPABASE_JWKS_URL="https://xxxx.supabase.co/auth/v1/.well-known/jwks.json"

# Legacy names are still supported by the code if your Supabase dashboard shows anon/service_role keys.
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── Server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
