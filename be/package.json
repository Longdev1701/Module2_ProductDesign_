{
  "name": "themis-lexiguard-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "test:legal-updates": "npm run build && node --test dist/modules/legal-updates/legal-updates.test.js",
    "db:seed": "npx prisma db seed"
  },
  "dependencies": {
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "@supabase/supabase-js": "^2.49.0",
    "@prisma/client": "^6.9.0",
    "@google/genai": "^2.4.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.0",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.14.0",
    "@types/morgan": "^1.9.9",
    "@types/node-cron": "^3.0.11",
    "prisma": "^6.9.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
