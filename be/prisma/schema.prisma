// ─── THEMIS LEXIGUARD — PRISMA SCHEMA ────────────────────
// Stack: PostgreSQL + Supabase Auth + Prisma ORM

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── AUTH, PROFILE & ORGANIZATION ───────────────────────

model Profile {
  id           String       @id // Maps to Supabase auth.users.id
  email        String       @unique
  fullName     String
  avatarUrl    String?
  jobTitle     String?      // Chức danh công việc (VD: Giám đốc XNK, Cán bộ Pháp chế)
  platformRole PlatformRole @default(USER) // Quyền trên toàn hệ thống/nền tảng
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  organizationMembers OrganizationMember[]
  auditLogs           AuditLog[]
  complianceChecks    ComplianceCheck[]

  @@map("profiles")
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  taxCode             String?
  address             String?
  legalRepresentative String?
  contactEmail        String?
  contactPhone        String?
  primaryProduct      String?  // Cà phê, Sầu riêng, v.v.
  exportMarkets       Json?    // ["EU", "CHINA", "USA"]
  exportForm          String?  // Chính ngạch, B2B, OEM
  exportScale         String?  // Sản lượng/năm
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  members     OrganizationMember[]
  invitations Invitation[]
  products    Product[]
  documents   Document[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  profile        Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(COMPLIANCE) // Quyền nội bộ doanh nghiệp
  status         MemberStatus     @default(ACTIVE)
  joinedAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_members")
}

enum PlatformRole {
  USER
  SUPPORT
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum OrganizationRole {
  OWNER
  MANAGER
  COMPLIANCE
  VIEWER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  INVITED
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrganizationRole @default(COMPLIANCE)
  token          String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  @@map("invitations")
}

// ─── PRODUCTS & BATCHES ─────────────────────────────────

model Product {
  id             String   @id @default(uuid())
  name           String
  category       String
  hsCode         String?
  description    String?
  origin         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  batches        Batch[]
  marketRequirements ProductMarketRequirement[]

  @@index([organizationId])
  @@map("products")
}

model Batch {
  id          String      @id @default(uuid())
  batchCode   String      @unique
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Float?
  unit        String?
  status      BatchStatus @default(DRAFT)
  producedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  complianceChecks ComplianceCheck[]
  documents        BatchDocument[]

  @@index([productId, status])
  @@map("batches")
}

enum BatchStatus {
  DRAFT
  COLLECTING_DOCUMENTS
  READY_FOR_CHECK
  CHECKING
  ACTION_REQUIRED
  COMPLIANT
  NON_COMPLIANT
  EXPIRED
}

model ProductMarketRequirement {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketCode String  // e.g., "EU", "US", "CN"
  marketName String

  @@unique([productId, marketCode])
  @@map("product_market_requirements")
}

// ─── DOCUMENTS ──────────────────────────────────────────

model Document {
  id             String       @id @default(uuid())
  title          String
  type           DocumentType
  fileUrl        String?
  fileSize       Int?
  mimeType       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  batches        BatchDocument[]

  @@index([organizationId, type])
  @@map("documents")
}

model BatchDocument {
  id         String   @id @default(uuid())
  batchId    String
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([batchId, documentId])
  @@map("batch_documents")
}

enum DocumentType {
  CO        // Certificate of Origin
  CQ        // Certificate of Quality
  PHYTO     // Phytosanitary Certificate
  LAB_REPORT
  CONTRACT
  INVOICE
  PACKING_LIST
  GPS_MAP   // Bản đồ định vị GPS (EUDR)
  OTHER
}

// ─── REGULATIONS ────────────────────────────────────────

model Regulation {
  id            String             @id @default(uuid())
  code          String             @unique  // e.g., "EC-396-2005"
  title         String
  description   String?
  category      RegulationCategory
  market        String             // e.g., "EU", "US"
  effectiveDate DateTime?
  sourceUrl     String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  complianceItems ComplianceItem[]
  mrlLimits       MRLLimit[]

  @@map("regulations")
}

enum RegulationCategory {
  MRL          // Maximum Residue Limits
  LABELING     // Nhãn mác
  PACKAGING    // Bao bì
  TRACEABILITY // Truy xuất nguồn gốc
  EUDR         // EU Deforestation Regulation
  ESG          // Environmental Social Governance
  FOOD_SAFETY  // An toàn thực phẩm
  OTHER
}

model MRLLimit {
  id           String     @id @default(uuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  substance    String     // e.g., "Chlorpyrifos"
  maxLimit     Float      // e.g., 0.01
  unit         String     @default("mg/kg")
  productGroup String?    // e.g., "Coffee", "Durian"
  createdAt    DateTime   @default(now())

  @@map("mrl_limits")
}

// ─── COMPLIANCE CHECK ───────────────────────────────────

model ComplianceCheck {
  id            String           @id @default(uuid())
  batchId       String
  batch         Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId        String
  profile       Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  market        String           // Target market
  checkStatus   CheckStatus      @default(QUEUED)
  result        ComplianceResult @default(MANUAL_REVIEW_REQUIRED)
  aiConfidence  Float?           // 0-100
  summary       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  items         ComplianceItem[]
  report        Report?

  @@index([batchId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("compliance_checks")
}

enum CheckStatus {
  QUEUED
  PROCESSING
  NEEDS_INPUT
  COMPLETED
  FAILED
  CANCELLED
  SUPERSEDED
}

enum ComplianceResult {
  COMPLIANT
  CONDITIONALLY_COMPLIANT
  NON_COMPLIANT
  INSUFFICIENT_INFORMATION
  NOT_APPLICABLE
  MANUAL_REVIEW_REQUIRED
}

model ComplianceItem {
  id                String           @id @default(uuid())
  complianceCheckId String
  complianceCheck   ComplianceCheck  @relation(fields: [complianceCheckId], references: [id], onDelete: Cascade)
  regulationId      String?
  regulation        Regulation?      @relation(fields: [regulationId], references: [id])
  requirement       String
  status            ComplianceResult
  deviation         String?          // Mô tả sai lệch
  remediation       String?          // Cách khắc phục
  severity          FindingSeverity  @default(INFORMATIONAL)
  createdAt         DateTime         @default(now())

  @@index([complianceCheckId, severity])
  @@map("compliance_items")
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

// ─── REPORTS ────────────────────────────────────────────

model Report {
  id                String          @id @default(uuid())
  complianceCheckId String          @unique
  complianceCheck   ComplianceCheck @relation(fields: [complianceCheckId], references: [id], onDelete: Cascade)
  title             String
  pdfUrl            String?
  version           Int             @default(1)
  status            ReportStatus    @default(DRAFT)
  integrityHash     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("reports")
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  FINAL
}

// ─── AUDIT LOG ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // e.g., "user.login_success", "org.created"
  entity     String   // e.g., "Organization", "Batch"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  REGULATION_UPDATE
  CHECK_COMPLETED
  RISK_ALERT
  SYSTEM
}
