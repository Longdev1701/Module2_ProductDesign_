# Copy this file to fe/.env.local and replace only the placeholder values.
# These NEXT_PUBLIC values are safe for browser use when Supabase RLS is enabled.
# Never add DATABASE_URL, DIRECT_URL, or SUPABASE_SERVICE_ROLE_KEY to frontend env files.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Legacy fallback. Use this only when the project does not have a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
